# === 測定用の私物（絶対に公開しない）===
# 公式ROM・吸い出しイメージ・市販ソフトなど、出自の証明が要る資材は
# すべて private/ に閉じ込める。ここに置いた物は git の目に入らない。
private/

# 拡張子ベースの二重防御（private/ の外に置いてしまった事故を止める）
*.rom
*.ROM
*.n88
*.N88
*.d88
*.D88
*.t88
*.88d
*.fdi
*.hdi
*.hdd

# ROM由来のバイト列を含みうる中間生成物
*.bin
*.dump
*.disasm
*.lst

# ビルド成果物
# 注: 自作の互換ROMバイナリも *.rom / *.bin に該当して無視される。
# これは意図的（うっかり公式ROMを混ぜないための防御を優先）。
# 配布は「ソースからのビルド」と GitHub Releases への添付で行い、
# リポジトリ本体にはバイナリを置かない。
build/
dist/
*.o
*.hex

# OS/エディタ
.DS_Store
*.swp

# Python のバイトキャッシュ
# 中身は tools/*.py（自作コード）のコンパイル結果なので規律上の実害は無いが、
# check_cleanroom.sh は「追跡されているバイナリ」を実害の有無に関わらず弾く。
# 検査が緑であること自体が証拠なので、例外を作らずに無視する側に倒す。
__pycache__/
*.pyc

# ハーネスのビルド成果物
tools/harness/frontend/q88measure
tools/harness/frontend/q88measure.d
