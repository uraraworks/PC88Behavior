+/* 0029: 書込み先の実体。VRAM・拡張RAMを作業域と取り違えない。 */
+static byte *b92_ram_pointer(word addr)
+{
+  if (addr < 0x8000) return write_mem_0000_7fff + addr;
+  if (addr < 0x8400) {
+    if (write_mem_8000_83ff) return write_mem_8000_83ff + (addr & 0x3ff);
+    addr = (addr & 0x3ff) + window_offset;
+    return addr < 0xf000 ? main_ram + addr : main_high_ram + (addr & 0xfff);
+  }
+  if (addr < 0xc000) return main_ram + addr;
+  if (vram_access_way == VRAM_ACCESS_ALU || vram_access_way == VRAM_ACCESS_BANK) return NULL;
+  return addr < 0xf000 ? write_mem_c000_efff + (addr & 0x3fff) :
+                       write_mem_f000_ffff + (addr & 0xfff);
+}
+static int b92_in_array(const byte *p, const byte *base, unsigned size)
+{
+  return p && (uintptr_t)p >= (uintptr_t)base &&
+         (uintptr_t)p - (uintptr_t)base < size;
+}
