diff --git a/src/pc88main.c b/src/pc88main.c
index e6a2374..d8ff9f1 100644
--- a/src/pc88main.c
+++ b/src/pc88main.c
@@ -2957,23 +2957,86 @@ void	main_io_out_with_BP( byte port, byte data )
  * ====================================================================== */
 
 #include "q88h_trace.h"
+#include "q88h_trap.h"
+
+/* ----------------------------------------------------------------------
+ * トラップROM足場（M2）
+ *
+ * trap->map[addr] が立っている番地が要求されたら、実 ROM が無くても
+ * 先へ進めるように RET（0xC9）を返すか、その場で HALT（0x76）にして
+ * 止める。どちらのモードでも「何番地が、どんな入口状態で要求されたか」
+ * を q88h_trap_record に残す。RET/HALT は Z80 の公開された命令コードで
+ * あって、ROM の内容とは無関係。
+ *
+ * caller（戻り番地）はスタック先頭2バイトから組む。ここで q88h_mem_read
+ * を呼ぶと trace 側の read カウンタまで動いてしまうので、必ず一段下の
+ * main_mem_read を直接呼ぶ。
+ * ---------------------------------------------------------------------- */
 
 static byte (*q88h_inner_fetch)( word );
 
 static byte q88h_fetch( word addr )
 {
-  q88h_trace_t *t = retro_q88h_trace();
+  q88h_trace_t *t  = retro_q88h_trace();
+  q88h_trap_t  *tp = retro_q88h_trap();
+
   t->mem_exec[addr] = 1;
   t->n_exec++;
+
+  if( tp->mode != Q88H_TRAP_OFF && tp->map[addr] ){
+    /* STOPモードで既に stopped が立っているなら、この fetch は
+     * HALT が同じPCを舐めているだけで新しい要求ではない。記録も
+     * 回数加算もせず、そのまま同じ 0x76 を返して停止状態を保つ。
+     * （q88h_trap_record は「起きた事実を書く」関数なので、
+     * 「起きたかどうか」の判断はここ＝呼び手の責任で済ませる） */
+    if( tp->mode == Q88H_TRAP_STOP && tp->stopped ){
+      return 0x76;
+    }
+
+    {
+      word caller = main_mem_read( z80main_cpu.SP.W )
+                  | (main_mem_read( (word)(z80main_cpu.SP.W + 1) ) << 8);
+
+      q88h_trap_record( tp, addr, Q88H_TRAP_EXEC,
+                         caller, z80main_cpu.PC_prev.W, z80main_cpu.SP.W,
+                         z80main_cpu.AF.W, z80main_cpu.BC.W,
+                         z80main_cpu.DE.W, z80main_cpu.HL.W );
+    }
+
+    if( tp->mode == Q88H_TRAP_RET ){
+      return 0xC9;                     /* RET  — 呼び元へ即座に返す */
+    }else{                             /* Q88H_TRAP_STOP */
+      tp->stopped   = 1;
+      tp->stop_addr = addr;
+      return 0x76;                     /* HALT — その場で止める */
+    }
+  }
+
   return q88h_inner_fetch( addr );
 }
 
 static byte q88h_mem_read( word addr )
 {
-  q88h_trace_t *t = retro_q88h_trace();
+  q88h_trace_t *t  = retro_q88h_trace();
+  q88h_trap_t  *tp = retro_q88h_trap();
+  byte          v;
+
   t->mem_read[addr] = 1;
   t->n_read++;
-  return main_mem_read( addr );
+  v = main_mem_read( addr );
+
+  /* データアクセスは値を差し替えない。挙動を変えるのは実行アクセスだけ。
+   * STOPモードで既に停止済みのあとのデータ読みも exec と同じ理由で
+   * 意味が無いので、記録しない扱いに揃える。 */
+  if( tp->mode != Q88H_TRAP_OFF && tp->map[addr]
+      && !(tp->mode == Q88H_TRAP_STOP && tp->stopped) ){
+    q88h_trap_record( tp, addr, Q88H_TRAP_DATA,
+                       0, z80main_cpu.PC_prev.W, z80main_cpu.SP.W,
+                       z80main_cpu.AF.W, z80main_cpu.BC.W,
+                       z80main_cpu.DE.W, z80main_cpu.HL.W );
+  }
+
+  return v;
 }
 
 static void q88h_mem_write( word addr, byte data )
