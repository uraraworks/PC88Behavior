+                         z80sub_cpu.AF.W, z80sub_cpu.BC.W,
+                         z80sub_cpu.DE.W, z80sub_cpu.HL.W );
+    }
+
+    q88h_sub_prev_fetch = addr;
+    if( tp->mode == Q88H_TRAP_RET ){
+      return 0xC9;                     /* RET */
+    }else{                             /* Q88H_TRAP_STOP */
+      tp->stopped   = 1;
