 /************************************************************************/
 /*									*/
 /************************************************************************/
+/* ======================================================================
+ * PC88Behavior 計測ハーネス — バスアクセスの採取
+ *
+ * 上流の実装をそのまま呼びつつ、触れたアドレスを記録するだけのラッパ。
+ * 挙動は変えない。記録するのはアドレスとアクセス種別であって、
+ * 読み書きした内容ではない。
+ *
+ * 要点は fetch を必ず自前のものにすること。上流は memory_wait も
+ * highspeed_mode も無効なとき fetch を main_mem_read に別名化するので、
+ * そのままでは「実行された番地」と「データとして読まれた番地」の区別が
+ * 消える。docs/PLAN.md 開発ループ ① はこの区別を前提にしている。
+ * ====================================================================== */
+
+#include "q88h_trace.h"
+
+static byte (*q88h_inner_fetch)( word );
+
+/* ----------------------------------------------------------------------
+ * fetch した番地の実体が ROM 像か RAM かを判定する。
+ *
+ * PC-88 は port $31 等で 0000-7FFF を ROM/RAM/拡張RAM に差し替えられる。
+ * 番地だけでは実体が分からないので、上流がバンク切替のたびに更新している
+ * read_mem_* ポインタ（main_memory_mapping_* が設定する）を見て、
+ * それが指す配列がどれかで判定する。main_fetch / main_mem_read と同じ
+ * 範囲分岐をなぞっているのは、判定ロジックを二重実装しないため
+ * （分岐がずれると気づかないまま食い違う）。値は読まず、ポインタの
+ * 所属先だけを見る。
+ * ---------------------------------------------------------------------- */
+static int q88h_ptr_in_rom( const byte *p )
+{
+  if( !p ) return 0;
+  if( p >= main_rom   && p < main_rom   + 0x8000 ) return 1;
+  if( p >= main_rom_n && p < main_rom_n + 0x8000 ) return 1;
+  if( main_rom_ext &&
+      p >= (const byte *)main_rom_ext &&
+      p <  (const byte *)main_rom_ext + 0x2000*4 )   return 1;
+  if( p >= dummy_rom && p < dummy_rom + 0x8000 )     return 1;
+  if( jisho_rom &&
+      p >= (const byte *)jisho_rom &&
+      p <  (const byte *)jisho_rom + 0x4000*32 )     return 1;
+  /* それ以外（main_ram / main_high_ram / ext_ram / dummy_ram / main_vram）は RAM */
+  return 0;
+}
+
+static int q88h_addr_is_rom( word addr )
+{
+  if     ( addr < 0x6000 ) return q88h_ptr_in_rom( read_mem_0000_5fff );
+  else if( addr < 0x8000 ) return q88h_ptr_in_rom( read_mem_6000_7fff );
+  else if( addr < 0x8400 ) return 0;   /* window は main_ram/main_high_ram のみ */
+  else if( addr < 0xc000 ) return 0;   /* main_ram 固定 */
+  else{
+    switch( vram_access_way ){
+    case VRAM_ACCESS_ALU:
+    case VRAM_ACCESS_BANK: return 0;   /* VRAM は RAM 扱い */
+    default:
+      if( addr < 0xf000 ) return q88h_ptr_in_rom( read_mem_c000_efff );
+      else                 return q88h_ptr_in_rom( read_mem_f000_ffff );
+    }
+  }
+}
+
+static byte q88h_fetch( word addr )
+{
+  q88h_trace_t *t = retro_q88h_trace();
+  t->mem_exec[addr] = 1;
+  if( q88h_addr_is_rom( addr ) ) t->mem_exec_rom[addr] = 1;
+  else                            t->mem_exec_ram[addr] = 1;
+  t->n_exec++;
+  return q88h_inner_fetch( addr );
+}
+
+static byte q88h_mem_read( word addr )
+{
+  q88h_trace_t *t = retro_q88h_trace();
+  t->mem_read[addr] = 1;
+  t->n_read++;
+  return main_mem_read( addr );
+}
+
+static void q88h_mem_write( word addr, byte data )
+{
+  q88h_trace_t *t = retro_q88h_trace();
+  t->mem_write[addr] = 1;
+  t->n_write++;
+  main_mem_write( addr, data );
+}
+
+static byte q88h_io_in( byte port )
+{
+  q88h_trace_t *t = retro_q88h_trace();
+  t->io_in[port] = 1;
+  t->n_in++;
+  return main_io_in( port );
+}
+
+static void q88h_io_out( byte port, byte data )
+{
+  q88h_trace_t *t = retro_q88h_trace();
+  t->io_out[port] = 1;
+  t->n_out++;
+  main_io_out( port, data );
+}
+
 void	pc88main_bus_setup( void )
 {
+  /* 上流が選ぶはずだったフェッチ関数を内側に置き、外側は常に自前のラッパ。
+   * こうすればウェイトの有無という時間的な挙動は保ったまま、
+   * 実行アクセスを取りこぼさない。 */
   if( memory_wait || highspeed_mode ){
-    z80main_cpu.fetch   = main_fetch;
+    q88h_inner_fetch    = main_fetch;
   }else{
-    z80main_cpu.fetch   = main_mem_read;
+    q88h_inner_fetch    = main_mem_read;
   }
-  z80main_cpu.mem_read  = main_mem_read;
-  z80main_cpu.mem_write = main_mem_write;
-  z80main_cpu.io_read   = main_io_in;
-  z80main_cpu.io_write  = main_io_out;
+  z80main_cpu.fetch     = q88h_fetch;
+  z80main_cpu.mem_read  = q88h_mem_read;
+  z80main_cpu.mem_write = q88h_mem_write;
+  z80main_cpu.io_read   = q88h_io_in;
+  z80main_cpu.io_write  = q88h_io_out;
 }
 
 
