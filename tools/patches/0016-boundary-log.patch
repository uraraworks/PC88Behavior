+/* ----------------------------------------------------------------------
+ * 番地の今の実体が ROM / 未割り当て / RAM のどれかを返す（ROM 境界の横断記録用）。
+ *
+ * q88h_addr_is_rom と同じ範囲分岐・同じポインタ（read_mem_*）を見るが、
+ * こちらは dummy_rom を「未割り当て」として ROM から分ける。番地の固定範囲で
+ * 決めない（バンク切替で同じ番地の実体が変わる）。値は読まず、ポインタの
+ * 所属先だけを見る。ext_ram / main_ram / main_high_ram / VRAM は RAM。
+ * ---------------------------------------------------------------------- */
+static int q88h_ptr_class( const byte *p )
+{
+  if( !p ) return Q88H_BND_RAM;
+  if( p >= dummy_rom  && p < dummy_rom  + 0x8000 ) return Q88H_BND_NONE;
+  if( p >= main_rom   && p < main_rom   + 0x8000 ) return Q88H_BND_ROM;
+  if( p >= main_rom_n && p < main_rom_n + 0x8000 ) return Q88H_BND_ROM;
+  if( main_rom_ext &&
+      p >= (const byte *)main_rom_ext &&
+      p <  (const byte *)main_rom_ext + 0x2000*4 ) return Q88H_BND_ROM;
+  if( jisho_rom &&
+      p >= (const byte *)jisho_rom &&
+      p <  (const byte *)jisho_rom + 0x4000*32 )   return Q88H_BND_ROM;
+  return Q88H_BND_RAM;
+}
+
+static int q88h_addr_class( word addr )
+{
+  if     ( addr < 0x6000 ) return q88h_ptr_class( read_mem_0000_5fff );
+  else if( addr < 0x8000 ) return q88h_ptr_class( read_mem_6000_7fff );
+  else if( addr < 0xc000 ) return Q88H_BND_RAM;   /* window / main_ram 固定 */
+  else{
+    switch( vram_access_way ){
+    case VRAM_ACCESS_ALU:
+    case VRAM_ACCESS_BANK: return Q88H_BND_RAM;   /* VRAM は RAM 扱い */
+    default:
+      if( addr < 0xf000 ) return q88h_ptr_class( read_mem_c000_efff );
+      else                 return q88h_ptr_class( read_mem_f000_ffff );
+    }
+  }
+}
+
+/* 命令の先頭 fetch を ROM 境界の記録へ渡す（enabled のときだけ呼ぶ）。
+ * スタック先頭の1語は、RAM → ROM の横断かどうかの判定にだけ使い、
+ * 判定が済めば捨てる（記録しない）。それ以外の瞬間は読まない
+ * （main_mem_read は VRAM の ALU 読み出し等の副作用を持ちうるため、
+ * 必要なときだけ最小限に読む）。 */
+static void q88h_boundary_note_instr( q88h_boundary_t *bd, word addr )
+{
+  int    cls = q88h_boundary_class_filter( bd, q88h_addr_class( addr ) );
+  word   sp  = z80main_cpu.SP.W;
+  word   top = 0;
+
+  if( cls == Q88H_BND_ROM && bd->last_class == Q88H_BND_RAM )
+    top = main_mem_read( sp ) | (main_mem_read( (word)(sp + 1) ) << 8);
+  q88h_boundary_on_instr( bd, addr, cls, sp, top, z80main_cpu.HL.W );
+}
