diff --git a/src/q88h_main_in_force.c b/src/q88h_main_in_force.c
new file mode 100644
index 0000000..503d98e
--- /dev/null
+++ b/src/q88h_main_in_force.c
@@ -0,0 +1,57 @@
+/*
+ * main CPU の IN の返り値の1ビットを強制する。無設定時は値をそのまま返す。
+ * リセット（retro_reset 等）では消えない。消すのは明示の reset 呼び出しだけ
+ * （q88h_exchange_intervention と同じ扱い）。
+ */
+#include <string.h>
+#include "q88h_main_in_force.h"
+
+static q88h_main_in_force_slot_t g_mif[Q88H_MAIN_IN_FORCE_SLOTS];
+
+void retro_q88h_main_in_force_reset(void)
+{
+    memset(g_mif, 0, sizeof(g_mif));
+}
+
+int retro_q88h_main_in_force_configure(unsigned slot, unsigned port,
+                                        unsigned bit, unsigned value)
+{
+    q88h_main_in_force_slot_t *s;
+    if (slot >= Q88H_MAIN_IN_FORCE_SLOTS || port > 0xFF || bit > 7 || value > 1)
+        return 0;
+    s = &g_mif[slot];
+    memset(s, 0, sizeof(*s));
+    s->port = (uint8_t)port;
+    s->bit = (uint8_t)bit;
+    s->value = (uint8_t)value;
+    s->enabled = 1;
+    return 1;
+}
+
+int retro_q88h_main_in_force_stats(unsigned slot, uint32_t *matched,
+                                    uint32_t *changed)
+{
+    if (slot >= Q88H_MAIN_IN_FORCE_SLOTS || !matched || !changed)
+        return 0;
+    *matched = g_mif[slot].matched;
+    *changed = g_mif[slot].changed;
+    return 1;
+}
+
+uint8_t q88h_main_in_force_process(uint8_t port, uint8_t value)
+{
+    unsigned i;
+    for (i = 0; i < Q88H_MAIN_IN_FORCE_SLOTS; i++) {
+        q88h_main_in_force_slot_t *s = &g_mif[i];
+        uint8_t nv;
+        if (!s->enabled || s->port != port)
+            continue;
+        s->matched++;
+        nv = s->value ? (uint8_t)(value | (1u << s->bit))
+                      : (uint8_t)(value & ~(1u << s->bit));
+        if (nv != value)
+            s->changed++;
+        value = nv;
+    }
+    return value;
+}
diff --git a/src/q88h_main_in_force.h b/src/q88h_main_in_force.h
new file mode 100644
index 0000000..961d9cf
--- /dev/null
+++ b/src/q88h_main_in_force.h
@@ -0,0 +1,34 @@
+/* main CPU の IN の返り値の1ビットを強制する、実測専用の使い捨てフック。
+ * 既定（未設定）では何もしない。sub CPU の IN には効かない。 */
+#ifndef Q88H_MAIN_IN_FORCE_H_INCLUDED
+#define Q88H_MAIN_IN_FORCE_H_INCLUDED
+
+#include <stdint.h>
+
+#define Q88H_MAIN_IN_FORCE_SLOTS 8
+
+typedef struct {
+    uint32_t matched;   /* 該当ポートの IN 回数 */
+    uint32_t changed;   /* 強制で実際に値が変わった回数 */
+    uint8_t port;
+    uint8_t bit;
+    uint8_t value;
+    uint8_t enabled;
+} q88h_main_in_force_slot_t;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void retro_q88h_main_in_force_reset(void);
+int retro_q88h_main_in_force_configure(unsigned slot, unsigned port,
+                                        unsigned bit, unsigned value);
+int retro_q88h_main_in_force_stats(unsigned slot, uint32_t *matched,
+                                    uint32_t *changed);
+/* main_io_in の返り値に強制を適用して返す。 */
+uint8_t q88h_main_in_force_process(uint8_t port, uint8_t value);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
