+void q88h_sub_reg_capture(char kind, uint16_t pc) {
+  unsigned i;
+  uint16_t r[Q88H_SNAPSHOT_REGS] = {
+    z80sub_cpu.AF.W, z80sub_cpu.BC.W, z80sub_cpu.DE.W, z80sub_cpu.HL.W,
+    z80sub_cpu.IX.W, z80sub_cpu.IY.W, kind == 'C' ? pc : z80sub_cpu.PC.W, z80sub_cpu.SP.W,
+    z80sub_cpu.AF1.W, z80sub_cpu.BC1.W, z80sub_cpu.DE1.W, z80sub_cpu.HL1.W,
+    z80sub_cpu.I, (z80sub_cpu.R & 0x7f) | (z80sub_cpu.R_saved & 0x80),
+    z80sub_cpu.IFF, z80sub_cpu.IFF2, z80sub_cpu.IM, z80sub_cpu.HALT
+  };
+  FILE *f = q88h_sub_reg_file();
+  fprintf(f, "%c", kind);
+  for (i = 0; i < Q88H_SNAPSHOT_REGS; i++) fprintf(f, " %04X", r[i]);
+  fputc('\n', f);
+}
