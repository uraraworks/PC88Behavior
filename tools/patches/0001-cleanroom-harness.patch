+static bool      q88h_rom_ok                    = false;
 static char      download_dir[OSD_MAX_FILENAME] = { '\0' };
 static char      system_dir[OSD_MAX_FILENAME]   = { '\0' };
 
@@ -454,12 +459,19 @@ static bool load_system_file(uint8_t bios_index, byte *rom_data, uint32_t rom_si
 
       strncpy(filename, bios_filenames[bios_index][i], sizeof(filename) - 1);
 
+      /* PC88Behavior: 上流はここで rom_filename を未初期化のまま
