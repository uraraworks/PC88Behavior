+      if (!filestream_exists(rom_filename) && !string_is_empty(system_dir))
          snprintf(rom_filename, sizeof(rom_filename), "%s%cquasi88%c%s", system_dir, SLASH, SLASH, filename);
 
       /* ...then the system folder itself. */
@@ -546,11 +558,32 @@ void retro_init(void)
 
    memory_allocate();
 
-   /* Fallback on pseudo BIOS if needed */
+   /* PC88Behavior 計測ハーネス:
+    *
+    * 上流はここで、公式 ROM が見つからないと黙って疑似 BIOS を流し込む。
+    * 測定用途ではこれが致命的になる。ROM のパスを間違えたときに、
+    * 公式 ROM を測っているつもりで第三者の実装を測ってしまい、
+    * その汚染された観測から仕様書を起こしてしまう。
+    *
+    * フォールバックは廃止し、ROM が揃わなければ起動を失敗させる。
+    * 「黙って別のものが動く」より「動かない」のほうが常に安全である。
+    */
+   q88h_rom_ok = TRUE;
    if (!load_system_file(N88_ROM, main_rom,   0x08000))
-      memcpy(main_rom, &pbios_n88, 0x08000);
+   {
+      if (log_cb)
+         log_cb(RETRO_LOG_ERROR,
+                "[PC88Behavior]: N88 ROM が見つからない。疑似BIOSへのフォールバックは"
+                " 計測結果を汚染するため無効化されている。起動を中止する。\n");
+      q88h_rom_ok = FALSE;
+   }
    if (!load_system_file(SUB_ROM, sub_romram, 0x00800))
-      memcpy(sub_romram, &pbios_disk, 0x00800);
+   {
+      if (log_cb)
+         log_cb(RETRO_LOG_ERROR,
+                "[PC88Behavior]: SUB(DISK) ROM が見つからない。起動を中止する。\n");
+      q88h_rom_ok = FALSE;
+   }
    rom_version = ROM_VERSION;
    load_system_file(EXT0_ROM,  main_rom_ext[0], 0x02000);
    load_system_file(EXT1_ROM,  main_rom_ext[1], 0x02000);
@@ -671,6 +704,18 @@ static bool load_m3u(const char *filename)
 
 bool retro_load_game(const struct retro_game_info *info)
 {
+   /* PC88Behavior: 公式 ROM が揃っていなければ、ここで確実に止める。
+    * 疑似BIOSによる代替は無効化してあるので、続行すると空の ROM 領域を
+    * 実行することになる。測定対象が不定のまま走るのが一番まずい。 */
+   if (!q88h_rom_ok)
+   {
+      if (log_cb)
+         log_cb(RETRO_LOG_ERROR,
+                "[PC88Behavior]: 必須ROMが揃っていないため起動しない。"
+                " PC88_REF_ROM_DIR の指す先を確認すること。\n");
+      return false;
+   }
+
    init_variables();
    quasi88_start();
    quasi88_disk_eject_all();
