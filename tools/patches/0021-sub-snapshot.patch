@@ -633,4 +635,22 @@
 {
   if( stateload_table( SID, suspend_pc88sub_work ) == STATE_OK ) return TRUE;
   else                                                           return FALSE;
+}
+
+void q88h_sub_snapshot_capture(void)
+{
+  q88h_sub_snapshot_t *s = retro_q88h_sub_snapshot();
+  q88h_sub_rom_read_t *r = retro_q88h_sub_rom_read();
+  uint16_t regs[Q88H_SNAPSHOT_REGS] = {
+    z80sub_cpu.AF.W, z80sub_cpu.BC.W, z80sub_cpu.DE.W, z80sub_cpu.HL.W,
+    z80sub_cpu.IX.W, z80sub_cpu.IY.W, z80sub_cpu.PC.W, z80sub_cpu.SP.W,
+    z80sub_cpu.AF1.W, z80sub_cpu.BC1.W, z80sub_cpu.DE1.W, z80sub_cpu.HL1.W,
+    z80sub_cpu.I, (z80sub_cpu.R & 0x7f) | (z80sub_cpu.R_saved & 0x80),
+    z80sub_cpu.IFF, z80sub_cpu.IFF2, z80sub_cpu.IM, z80sub_cpu.HALT
+  };
+  if (!s->enabled || s->captured || r->current_fc != s->target) return;
+  memcpy(s->ram, sub_romram + 0x4000, sizeof(s->ram));
+  memcpy(s->writer, r->writer + 0x4000, sizeof(s->writer));
+  memcpy(s->regs, regs, sizeof(regs));
+  s->captured = 1;
 }
